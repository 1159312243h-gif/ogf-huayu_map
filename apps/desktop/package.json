{
  "name": "huayu-atlas-desktop",
  "version": "9.0.0",
  "private": true,
  "description": "华域地图桌面应用",
  "author": {
    "name": "Huayu Atlas contributors",
    "email": "249743200+1159312243h-gif@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.huayu.atlas",
    "productName": "华域地图",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "app.json",
      "icons/**"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "Huayu-Atlas-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "icons/icon-512.png",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "icons/icon-512.png"
    },
    "publish": null
  },
  "packageManager": "pnpm@11.25.0",
  "homepage": "https://ogf-atlas.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/1159312243h-gif/ogf-huayu_map.git"
  },
  "desktopName": "huayu-atlas.desktop"
}
